# Copy to .env and fill in the real key. .env is ignored by git.

# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash

# Optional: override endpoint if needed.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Batch concurrency. Keep 1 for local Ollama; 3-6 works well for DeepSeek.
MAX_CONCURRENCY=4

# Optional limits.
LLM_TIMEOUT=180
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=5
